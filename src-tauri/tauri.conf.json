{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YTHub",
  "version": "1.0.0",
  "identifier": "dev.ravindran.ythub",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "YTHub — Your YouTube Media Hub", "width": 1280, "height": 820, "minWidth": 920, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://*.ytimg.com https://*.ggpht.com data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "resources": {"binaries/":"binaries/", "../THIRD_PARTY_NOTICES.md":"THIRD_PARTY_NOTICES.md", "../LICENSE":"LICENSE"}, "icon": ["icons/icon.ico"], "shortDescription": "Your YouTube Media Hub", "copyright": "Copyright © 2026 Ravindran", "windows": { "nsis": { "displayLanguageSelector": false, "compression":"zlib" } } }
}
